data/careerai/runs.jsonl
apps/orca/chrome_profile/
data/careerai/harvest.jsonl

# Docker Desktop -> WSL migration backups (binarios locales, no versionados)
05_Backups/docker-volumes-migration/

# Dependencias instaladas -- nunca se versionan (gap preexistente en este .gitignore,
# confirmado real: node_modules NO estaba cubierto antes de instalar platform/client-gateway)
node_modules/
**/node_modules/
**/dist/
**/.turbo/

# Contenido descartado durante reorg R01/R02 -- conservado sin borrar, nunca trackeado
historicos/

# Capturas de perfiles de navegador (Chrome) usadas en investigacion de hyperframes --
# contienen archivos reales "Login Data" (SQLite de contraseñas guardadas de Chrome,
# cifradas pero sensibles). Se dejan en su ubicacion local, nunca se trackean.
08_Research_Labs/hyperframes/captures/
**/hyperframes/captures/

# Perfiles de Chrome usados por pruebas e2e de apps/site -- mismo motivo que
# hyperframes/captures/: contienen Login Data/Cookies reales de Chrome.
apps/site/tests/e2e/.runtime/
**/.runtime/chrome-user-data/
**/.runtime/headless-user-data/

# .runtime/ corporativo -- "Fuera de Git" por diseno (seccion 2.1: bootstrap, data,
# artifacts, logs, models, backups, recovery). Datos regenerables/operacionales, no
# fuente versionada.
/.runtime/

# archives/source -- contenido historico de 09_Archives (perfil de Chrome, y un
# refactor de EasyCount con .env/.env.local sustanciales sin auditar linea por linea).
# Se reubica fisicamente pero NUNCA se trackea sin auditoria explicita de secretos.
archives/source/

# Checkouts independientes con su propio .git y remote -- el repo corporativo
# NUNCA incorpora su contenido (ni como archivos ni como gitlink de submodulo).
# Se registran en governance/registry/projects/*.json, no se comitean aqui.
products/getupnet/

# Odoo Enterprise (licencia comercial) -- mirrors/checkouts de terceros con su
# propio .git y remote real. NUNCA se embeben como contenido/gitlink en el
# repo corporativo. Se registran en governance/registry/projects/odoo-erp.json.
integrations/odoo/shared-addons/v16/
integrations/odoo/shared-addons/v17/
integrations/odoo/shared-addons/v18/
