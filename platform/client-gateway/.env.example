NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://orca:orca@localhost:5432/orca
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

PAIRING_CODE_TTL_SECONDS=900
DEVICE_CREDENTIAL_TTL_SECONDS=86400

COMMAND_DEFAULT_TTL_SECONDS=300
COMMAND_MAX_TTL_SECONDS=3600

AUDIT_REDACTION_ENABLED=true

TUNNEL_PROVIDER=mock
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

RUNTIME_STORAGE_PATH=./storage/runtimes
FLOW_STORAGE_PATH=./storage/flows

SIGNING_PRIVATE_KEY_PATH=./secrets/dev-signing-private.pem
SIGNING_PUBLIC_KEY_PATH=./secrets/dev-signing-public.pem
