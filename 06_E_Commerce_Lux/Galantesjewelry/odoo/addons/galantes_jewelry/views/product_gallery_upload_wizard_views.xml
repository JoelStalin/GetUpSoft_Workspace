<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_gallery_upload_wizard_form" model="ir.ui.view">
        <field name="name">galantes.product.gallery.upload.wizard.form</field>
        <field name="model">galantes.product.gallery.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Subir fotos del producto">
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="attachment_ids"
                               widget="many2many_binary"
                               string="Arrastra y suelta varias fotos aquí"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Puedes seleccionar varias imágenes a la vez o arrastrarlas desde tu computadora.
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Subir fotos" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="product_gallery_upload_wizard_action" model="ir.actions.act_window">
        <field name="name">Subir fotos</field>
        <field name="res_model">galantes.product.gallery.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
