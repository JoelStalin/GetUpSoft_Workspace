# Copia este archivo como .env y llena los valores
# Copy this file as .env and fill in the values

CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Requeridas por el servicio `web` en docker-compose.yml (sin default
# inseguro desde 2026-09-18, hallazgo de seguridad P1 en PR #16) -- sin
# estas variables, `docker compose up` falla intencionalmente en vez de
# arrancar con credenciales de admin publicas conocidas.
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_admin_password_here
ADMIN_SECRET_KEY=your_admin_session_secret_here
